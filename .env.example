# Environment Configuration Template for FieldTest Companion
# Copy this file to .env and configure values for your deployment environment.

# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=django-insecure-fieldtest-companion-production-secret-key-template-change-me

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or IP addresses)
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
