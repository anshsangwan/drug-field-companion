cat > .gitignore <<'EOF'
# ── Documentation we keep locally ─────────────────────────────────
*.md
*.docx
*.pdf
*.pptx
*.ppt
*.odt
*.tex

# ── Other files we usually don’t want in the repo ───────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3          # local SQLite DB (optional)
.env
.env.*
.DS_Store
Thumbs.db
EOF